(version 1)

# USB-C J1 (HRO TYPE-C-31-M-12 footprint): GND pads A1/A12/B1/B12 sit 0.194 mm from the
# NPTH locating pegs by design. JLCPCB accepts >= 0.15 mm NPTH-to-copper, so allow it only here.
(rule "J1 USB-C NPTH peg to pad"
	(constraint hole_clearance (min 0.19mm))
	(condition "A.memberOfFootprint('J1') && B.memberOfFootprint('J1')"))
(rule "In2 power and camera routing"
  (layer "In2.Cu")
  (condition "A.NetName != '/1V5' && A.NetName != '/2V8' && A.NetName != '/CAM_RESET' && A.NetName != '/CAM_Y4' && A.NetName != '/CAM_Y7'")
  (constraint disallow track))
